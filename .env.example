APP_NAME=Stickler
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://stickler.test

APP_TIMEZONE=Europe/Brussels
APP_LOCALE=nl_BE
APP_FALLBACK_LOCALE=en_US
APP_FAKER_LOCALE=nl_BE

# APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# BCRYPT_ROUNDS=12

# LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=180
# SESSION_ENCRYPT=false
# SESSION_PATH=/
# SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# Filesystem disk used by filament
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

# CACHE_STORE=database
# CACHE_PREFIX=

# MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_ADDRESS="ceo@example.com"
MAIL_REPLY_NAME="Jane Ceo"

AWS_BUCKET=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
AWS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#
# Telescope package variables
#
TELESCOPE_ENABLED=true
TELESCOPE_PATH=admin/telescope

#
# Log Viewer package variables
#

LOG_VIEWER_ENABLED=true
LOG_VIEWER_API_ONLY=false

#
# Spatie packages variables
#

# MEDIA_DISK=s3
# MEDIA_DISK_DRIVER=s3
MEDIA_DISK=media
MEDIA_DISK_DRIVER=local
MEDIA_DISK_ROOT_PATH=app/public/media
MEDIA_DISK_URL_PATH=storage/media
MEDIA_DISK_VISIBILITY=public
MEDIA_DISK__THROW=false
MEDIA_DISK_REPORT=false
MEDIA_QUEUE=media
MEDIA_PREFIX=library
IMAGE_DRIVER=imagick
FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"
FFPROBE_PATH="C:/ffmpeg/bin/ffprobe.exe"
# FFMPEG_PATH="/var/www/bin/ffmpeg/ffmpeg"
# FFPROBE_PATH="/var/www/bin/ffmpeg/ffprobe"

SETTINGS_CACHE_ENABLED=true
SETTINGS_CACHE_MEMO=true

RESPONSE_CACHE_ENABLED=false

ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_BUFFER_ENABLED=false

HTTP_LOGGER_ENABLED=true
HTTP_LOGGER_CHANNEL=http

BACKUP_ARCHIVE_PASSWORD="password"
BACKUP_DISK=backups
BACKUP_DISK_DRIVER=local
BACKUP_DISK_ROOT_PATH=app/private/backups
BACKUP_DISK_URL_PATH=storage/backups
BACKUP_DISK_VISIBILITY=private
BACKUP_DISK__THROW=false
BACKUP_DISK_REPORT=false

HONEYPOT_ENABLED=true
HONEYPOT_NAME="my_first_name"
HONEYPOT_RANDOMIZE=true
HONEYPOT_VALID_FROM_TIMESTAMP=true
HONEYPOT_VALID_FROM="valid_from"
HONEYPOT_SECONDS=1

COOKIE_CONSENT_ENABLED=true

#
# Stickler config variables
#

ST_ADMIN_NAME="John Doe"
ST_ADMIN_EMAIL="admin@example.com"
ST_ADMIN_PASSWORD="password"

ST_CEO_NAME="Jane Ceo"
ST_CEO_EMAIL="ceo@example.com"
ST_CEO_PASSWORD="password"

ST_CONTACT_NAME="Jane Ceo"
ST_CONTACT_COMPANY_NAME="Stickler"
ST_CONTACT_COMPANY_NUMBER="BE 1234.567.890"
ST_CONTACT_ADDRESS="Streetname 123"
ST_CONTACT_CITY="1000 Brussel"
ST_CONTACT_COUNTRY="Belgium"
ST_CONTACT_EMAIL="ceo@example.com"
ST_CONTACT_PHONE="+32444000000"

ST_SOCIAL_FACEBOOK="https://www.facebook.com/"
ST_SOCIAL_INSTAGRAM="https://www.instagram.com/"
ST_SOCIAL_LINKEDIN="https://www.linkedin.com/"
